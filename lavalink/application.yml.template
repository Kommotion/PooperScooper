plugins:
  lavasrc:
    providers:
      - "dzisrc:%ISRC%"
      - "dzsearch:%QUERY%"
      - "ytsearch:\"%ISRC%\""
      - "ytsearch:%QUERY%"
    sources:
      spotify: true
      deezer: false
      ytdlp: true
    spotify:
      clientId: "{{SPOTIFY_CLIENT_ID}}"
      clientSecret: "{{SPOTIFY_SECRET}}"
      countryCode: "{{SPOTIFY_COUNTRY_CODE}}"
      playlistLoadLimit: 6
      albumLoadLimit: 6
    deezer:
      arl: "{{DEEZER_ARL}}"
      formats: ["MP3_128", "MP3_64"]
    ytdlp:
      path: "{{YTDLP_PATH}}"
      searchLimit: 10
      playlistLoadLimit: 1000
      customLoadArgs: ["-q", "--no-warnings", "--flat-playlist", "--skip-download", "-J"]
      customPlaybackArgs: ["-q", "--no-warnings", "-f", "bestaudio", "-J"]

server:
  port: {{LAVALINK_PORT}}
  address: 0.0.0.0

lavalink:
  plugins:
    - dependency: "com.github.topi314.lavasrc:lavasrc-plugin:4.8.3"
  server:
    password: "{{LAVALINK_PASSWORD}}"
    sources:
      youtube: false
      bandcamp: true
      soundcloud: true
      http: true
      local: false
    filters:
      volume: true
    bufferDurationMs: 1000
    frameBufferDurationMs: 10000
    youtubeSearchEnabled: false
    soundcloudSearchEnabled: true

logging:
  file:
    path: ./logs/
  level:
    root: INFO
    lavalink: INFO